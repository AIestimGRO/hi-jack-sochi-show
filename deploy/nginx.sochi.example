# Dedicated HTTPS vhost for SOCHI SHOW only.
# Install ONLY after DNS and certificate for sochi.hijackpoker.ru are ready.
# Existing JACKSIDE and Timer Nginx vhosts must not be edited.

server {
    listen 80;
    server_name sochi.hijackpoker.ru;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/sochi-certbot;
        try_files $uri =404;
    }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name sochi.hijackpoker.ru;
    ssl_certificate /etc/letsencrypt/live/sochi.hijackpoker.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sochi.hijackpoker.ru/privkey.pem;
    client_max_body_size 6m;

    # Short browser URLs; proxy internally, without changing the address bar.
    location = / {
        proxy_pass http://127.0.0.1:8092/sochi/screen;
        include /etc/nginx/proxy_params;
    }
    location = /admin {
        proxy_pass http://127.0.0.1:8092/sochi/admin;
        include /etc/nginx/proxy_params;
    }

    # Existing application links resolve to the short address on this host.
    location = /sochi/screen { return 302 /; }
    location = /sochi/admin { return 302 /admin; }

    # All API, static resources and SSE stay isolated under /sochi/.
    location ^~ /sochi/ {
        proxy_pass http://127.0.0.1:8092;
        include /etc/nginx/proxy_params;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 120s;
    }

    location / { return 404; }
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
}
