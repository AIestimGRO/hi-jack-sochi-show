[Unit]
Description=HI JACK SOCHI SHOW - independent staging service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/sochi-show
EnvironmentFile=/opt/sochi-show/.env
ExecStart=/opt/sochi-show/.venv/bin/uvicorn sochi_show.server:app --host 127.0.0.1 --port 8092 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/sochi-show/data

[Install]
WantedBy=multi-user.target
